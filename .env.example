# Identifiants OAuth Google (console.cloud.google.com > Identifiants)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chaîne aléatoire : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL publique du site (URI de redirection Google : BASE_URL/auth/callback)
BASE_URL=http://localhost:3000

# Emails autorisés, séparés par des virgules
ALLOWED_EMAILS=moi@gmail.com

# Optionnel : dossier de stockage (défaut : ./files)
STORAGE_DIR=

# Optionnel : port (défaut : 3000)
PORT=3000
